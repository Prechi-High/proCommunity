# Local worker secrets. Copy from the repo .env.example values you actually have.
# Never commit this file. Use a development Upstash database, not production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_REDIS_ENV=development
ASR_QUEUE_KEY=asr:jobs:dev
ASR_PROCESSING_KEY=asr:processing:dev
ASR_DEAD_KEY=asr:dead:dev
ASR_DELAYED_KEY=asr:delayed:dev
