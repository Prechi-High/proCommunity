# Inlined into the web bundle at `expo export` / Vercel build. If these are
# empty on Vercel, product pages cannot read video_cache or invoke discovery.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_DATA_API_KEY=
# Product search is YouTube-only (youtube-fetch). Serper is parked.
# To re-enable multi-platform Serper later, set Edge secret
# VIDEO_DISCOVERY_PROVIDER=serper and fill SERPER_API_KEY.
# SERPER_API_KEY=
VIDEO_DISCOVERY_PROVIDER=youtube
# Classifier (Edge Function secrets). Any one is enough; the rest are fallbacks
# in this order: Gemini → OpenRouter → NVIDIA. Do not prefix EXPO_PUBLIC_.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Optional model overrides.
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
CLASSIFICATION_CONFIDENCE_FLOOR=0.70
# MUST be true before any real public user. Also flip
# app_flags.video_review_enabled in Postgres — RLS cannot read this env var.
VIDEO_REVIEW_ENABLED=false
# Optional. Raises Meta oEmbed rate limits after App Review.
META_OEMBED_TOKEN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
# Upstash Redis — server-side only (Edge Functions, Vercel api/, ASR worker).
# Never prefix EXPO_PUBLIC_. Used for ASR queue (asr:*) AND read cache (cache:*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional aliases (same REST URL/token). Prefer UPSTASH_* above.
REDIS_URL=
REDIS_TOKEN=
# Read-cache TTLs in seconds (defaults shown).
CACHE_TTL_PRODUCT_SEC=1800
CACHE_TTL_VIDEOS_SEC=600
CACHE_TTL_COMMENTS_SEC=600
CACHE_TTL_TAXONOMY_SEC=3600
# Set to 1 for cache_hit / cache_miss / redis_error logs in development.
CACHE_DEBUG=
ASR_QUEUE_KEY=asr:jobs
ASR_PROCESSING_KEY=asr:processing
ASR_DEAD_KEY=asr:dead
ASR_DELAYED_KEY=asr:delayed
# Worker-only. Never prefix EXPO_PUBLIC_. Never bake into the Docker image.
SUPABASE_URL=
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_REDIS_ENV=development
AWS_REGION=eu-west-1
