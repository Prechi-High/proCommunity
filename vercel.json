{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/r/:token", "destination": "/api/r/:token" },
    { "source": "/((?!api|_expo|assets).*)", "destination": "/index.html" }
  ]
}
