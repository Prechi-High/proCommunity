{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    },
    {
      "source": "/((?!api|_expo|assets).*)",
      "destination": "/index.html"
    }
  ]
}
