{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:auth && npm run typecheck && npm run test:parallel-research && npm run test:dynamic-ui && expo export --platform web",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    },
    {
      "source": "/((?!api|_expo|assets).*)",
      "destination": "/index.html"
    }
  ]
}
