{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "rm -rf dist .expo && NODE_OPTIONS='--max-old-space-size=8192' npm run export:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    },
    {
      "source": "/((?!api|_expo|assets).*)",
      "destination": "/index.html"
    }
  ]
}
